<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:contentDescription="@string/widget_accessibility">
    <LinearLayout
        android:id="@+id/widget_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_claude" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Claude"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/claude_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:gravity="right"
                    android:singleLine="true"

                    android:textColor="@color/widget_muted"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/claude_5h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:importantForAccessibility="yes"
                android:contentDescription="Claude 5시간 기록 없음">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:text="@string/widget_window_5h"
                        android:textColor="@color/widget_ink_2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/claude_5h_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:gravity="right"
                        android:text="@string/widget_missing"
                        android:textColor="@color/widget_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/claude_5h_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no"
                    android:indeterminate="false"
                    android:max="100"
                    android:visibility="invisible"
                    android:progressTint="@color/widget_claude"
                    android:progressBackgroundTint="@color/widget_grid" />
                <TextView
                    android:id="@+id/claude_5h_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/widget_no_record"
                    android:textColor="@color/widget_muted"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/claude_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:importantForAccessibility="yes"
                android:contentDescription="Claude 주간 기록 없음">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:text="@string/widget_window_week"
                        android:textColor="@color/widget_ink_2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/claude_week_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:gravity="right"
                        android:text="@string/widget_missing"
                        android:textColor="@color/widget_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/claude_week_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no"
                    android:indeterminate="false"
                    android:max="100"
                    android:visibility="invisible"
                    android:progressTint="@color/widget_claude"
                    android:progressBackgroundTint="@color/widget_grid" />
                <TextView
                    android:id="@+id/claude_week_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/widget_no_record"
                    android:textColor="@color/widget_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:importantForAccessibility="no"
            android:background="@color/widget_grid" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot_codex" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="Codex"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/codex_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:gravity="right"
                    android:singleLine="true"

                    android:textColor="@color/widget_muted"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/codex_5h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:importantForAccessibility="yes"
                android:contentDescription="Codex 5시간 기록 없음">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:text="@string/widget_window_5h"
                        android:textColor="@color/widget_ink_2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/codex_5h_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:gravity="right"
                        android:text="@string/widget_missing"
                        android:textColor="@color/widget_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/codex_5h_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no"
                    android:indeterminate="false"
                    android:max="100"
                    android:visibility="invisible"
                    android:progressTint="@color/widget_codex"
                    android:progressBackgroundTint="@color/widget_grid" />
                <TextView
                    android:id="@+id/codex_5h_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/widget_no_record"
                    android:textColor="@color/widget_muted"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/codex_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:importantForAccessibility="yes"
                android:contentDescription="Codex 주간 기록 없음">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:text="@string/widget_window_week"
                        android:textColor="@color/widget_ink_2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/codex_week_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        android:gravity="right"
                        android:text="@string/widget_missing"
                        android:textColor="@color/widget_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/codex_week_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="no"
                    android:indeterminate="false"
                    android:max="100"
                    android:visibility="invisible"
                    android:progressTint="@color/widget_codex"
                    android:progressBackgroundTint="@color/widget_grid" />
                <TextView
                    android:id="@+id/codex_week_reset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:importantForAccessibility="no"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/widget_no_record"
                    android:textColor="@color/widget_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:includeFontPadding="false"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_ink_2"
        android:textSize="13sp"
        android:visibility="visible" />
</FrameLayout>
