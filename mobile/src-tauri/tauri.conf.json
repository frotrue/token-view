{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token View",
  "version": "../../package.json",
  "identifier": "com.tokenview.mobile",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev:mobile",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix .. run build:mobile",
    "frontendDist": "../../dist-mobile"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Token View" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
