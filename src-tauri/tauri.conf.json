{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token View",
  "version": "../package.json",
  "identifier": "com.tokenview.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Token View",
        "width": 1320,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0d0d0d",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "frotrue",
    "shortDescription": "Claude Code · Codex 토큰 사용량 모니터",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDQkVEMDNGRUM3OEZDNEEKUldSSy9IanNQOUMrSFArS29QSUs0UHlmdUhvaGt2eUxYYnlwb1RkMS9mL3FIL2JXcFlvd2lKZXAK",
      "endpoints": [
        "https://github.com/frotrue/token-view/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}